---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

const rutas = await getCollection('rutas');
---

<Layout title="Catálogo de Rutas - Amukan Ride">
  <main class="max-w-6xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-center mb-12">Catálogo de Rutas</h1>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {rutas.map((ruta) => {
        // Limpiamos el ID para compatibilidad con Astro v5
        const cleanSlug = ruta.id.replace(/\/?index(\.mdx?)?$/, '').replace(/\.mdx?$/, '');
        
        return (
          <article class="bg-gray-900 rounded-lg overflow-hidden shadow-lg border border-gray-800 hover:border-gray-700 transition-colors">
            <a href={`/rutas/${cleanSlug}`} class="block overflow-hidden h-48">
              {/* Blindaje condicional para la imagen */}
              {ruta.data.coverImage ? (
                <Image 
                  src={ruta.data.coverImage} 
                  alt={ruta.data.title}
                  width={600}
                  height={400}
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                />
              ) : (
                <div class="w-full h-full bg-gray-800 flex items-center justify-center hover:bg-gray-700 transition-colors">
                  <span class="text-gray-500 text-sm">Sin imagen de portada</span>
                </div>
              )}
            </a>
            
            <div class="p-6">
              <a href={`/rutas/${cleanSlug}`}>
                <h2 class="text-xl font-bold mb-2 hover:text-blue-400 transition-colors">
                  {ruta.data.title}
                </h2>
              </a>
              {ruta.data.description && (
                <p class="text-gray-400 text-sm mb-4 line-clamp-3">
                  {ruta.data.description}
                </p>
              )}
              
              {/* Etiquetas de datos adicionales */}
              <div class="flex flex-wrap gap-2 text-xs font-medium mt-4">
                {ruta.data.distance && (
                  <span class="bg-gray-800 px-2 py-1 rounded text-gray-300">↔ {ruta.data.distance} km</span>
                )}
                {ruta.data.difficulty && (
                  <span class="bg-blue-900/50 text-blue-200 px-2 py-1 rounded">{ruta.data.difficulty}</span>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </main>
</Layout>