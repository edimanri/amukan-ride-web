---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

// Obtenemos todas las rutas desde la carpeta content/rutas
const rutas = await getCollection('rutas');
---

<Layout title="Catálogo de Rutas">
  <div class="max-w-6xl mx-auto py-20 px-4">
    <header class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-bold text-white tracking-tight">Catálogo de Rutas</h1>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {rutas.map((ruta) => {
        // Limpiamos el ID para generar una URL limpia
        const cleanSlug = ruta.id.replace(/\/?index(\.mdx?)?$/, '').replace(/\.mdx?$/, '');
        
        return (
        <a href={`/rutas/${cleanSlug}`} class="bg-gray-800 border border-gray-700 hover:border-yellow-500 transition-colors rounded-2xl overflow-hidden block group flex flex-col h-full">
          
          {/* Lógica de Miniatura priorizando YouTube */}
          {ruta.data.youtubeId ? (
            <div class="aspect-video relative overflow-hidden bg-gray-900">
               <img 
                  src={`https://img.youtube.com/vi/${ruta.data.youtubeId}/maxresdefault.jpg`} 
                  alt={`Video de ${ruta.data.title}`} 
                  class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-500"
                  onError="this.src=`https://img.youtube.com/vi/${ruta.data.youtubeId}/hqdefault.jpg`"
                />
                <div class="absolute inset-0 flex items-center justify-center opacity-80 group-hover:opacity-100 transition-opacity">
                    <div class="bg-yellow-500 text-gray-900 rounded-full p-3 shadow-lg">
                        <svg class="w-8 h-8 ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                    </div>
                </div>
            </div>
          ) : ruta.data.coverImage ? (
            <div class="aspect-video relative overflow-hidden bg-gray-900">
              <Image 
                src={ruta.data.coverImage} 
                alt={ruta.data.title} 
                class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-500" 
              />
            </div>
          ) : (
            <div class="aspect-video bg-gray-900 flex items-center justify-center text-gray-600">
              Sin imagen de portada
            </div>
          )}

          <div class="p-6 flex flex-col flex-grow">
            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-yellow-500 transition-colors">{ruta.data.title}</h3>
            {ruta.data.description && <p class="text-sm text-gray-400 mb-4 flex-grow">{ruta.data.description}</p>}
            <div class="flex gap-2 text-xs font-medium mt-auto pt-4 border-t border-gray-700/50">
              {ruta.data.distance && <span class="px-2 py-1 bg-gray-900 text-gray-300 rounded border border-gray-700">↔ {ruta.data.distance}</span>}
              {ruta.data.difficulty && <span class="px-2 py-1 bg-yellow-500/10 text-yellow-500 rounded border border-yellow-500/20">{ruta.data.difficulty}</span>}
            </div>
          </div>
        </a>
      )})}
    </div>
  </div>
</Layout>