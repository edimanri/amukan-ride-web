---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Catálogo de Rutas">
  <div class="max-w-6xl mx-auto py-20 px-4">
    <header class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-bold text-white tracking-tight">Catálogo de Rutas</h1>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <a href="#" class="bg-gray-800 border border-gray-700 hover:border-yellow-500 transition-colors rounded-2xl overflow-hidden block group">
        <div class="h-48 bg-gray-900 flex items-center justify-center text-gray-600">
          Sin imagen de portada
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold text-white mb-2 group-hover:text-yellow-500 transition-colors">San Cristobal Norte</h3>
          <p class="text-sm text-gray-400 mb-4">Descripción de prueba</p>
          <div class="flex gap-2 text-xs font-medium">
            <span class="px-2 py-1 bg-gray-900 text-gray-300 rounded border border-gray-700">↔ 4.5 km</span>
            <span class="px-2 py-1 bg-yellow-500/10 text-yellow-500 rounded border border-yellow-500/20">Intermedio</span>
          </div>
        </div>
      </a>
    </div>
  </div>
</Layout>