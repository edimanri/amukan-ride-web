---
// Ruta: src/pages/rutas/[slug].astro
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const rutasEntries = await getCollection('rutas');
  return rutasEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title}>
  <article class="max-w-4xl mx-auto py-10 px-4 w-full flex-grow">
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-bold text-emerald-400 mb-4">{entry.data.title}</h1>
      <p class="text-lg text-slate-300 mb-8 max-w-2xl mx-auto">{entry.data.description}</p>
      
      <Image 
        src={entry.data.cover} 
        alt={entry.data.title} 
        class="w-full h-64 md:h-96 object-cover rounded-xl shadow-lg border border-slate-800 mb-8"
      />

      <!-- Panel Técnico Estilo Andeshandbook -->
      <div class="grid grid-cols-3 gap-4 bg-slate-800/50 p-6 rounded-xl border border-slate-700">
        <div class="flex flex-col items-center">
          <span class="text-slate-400 text-sm uppercase tracking-wider mb-1">Distancia</span>
          <span class="text-2xl font-bold text-slate-100">{entry.data.distance} <span class="text-base text-emerald-400">km</span></span>
        </div>
        <div class="flex flex-col items-center border-x border-slate-700">
          <span class="text-slate-400 text-sm uppercase tracking-wider mb-1">Desnivel</span>
          <span class="text-2xl font-bold text-slate-100">{entry.data.elevation} <span class="text-base text-emerald-400">m+</span></span>
        </div>
        <div class="flex flex-col items-center">
          <span class="text-slate-400 text-sm uppercase tracking-wider mb-1">Dificultad</span>
          <span class="text-lg font-bold text-emerald-400 mt-1">{entry.data.difficulty}</span>
        </div>
      </div>
    </header>
    
    <div class="mdx-content text-slate-200 leading-relaxed">
      <Content />
    </div>
  </article>
</Layout>

<style is:global>
  @reference "../../styles/global.css";

  .mdx-content h2 {
    @apply text-2xl font-bold text-emerald-300 mt-10 mb-4;
  }
  .mdx-content h3 {
    @apply text-xl font-semibold text-emerald-200 mt-8 mb-3;
  }
  .mdx-content p {
    @apply mb-6;
  }
  .mdx-content strong {
    @apply text-white font-semibold;
  }
  .mdx-content ul {
    @apply list-disc list-inside mb-6 space-y-2;
  }
  .mdx-content li {
    @apply text-slate-300;
  }
</style>