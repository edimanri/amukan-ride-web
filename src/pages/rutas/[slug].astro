---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

// ESTA LÍNEA ES LA CLAVE PARA EVITAR EL CRASH SSR
export const prerender = true; 

export async function getStaticPaths() {
  const rutas = await getCollection('rutas');
  return rutas.map(ruta => {
    const cleanSlug = ruta.id.replace(/\/?index(\.mdx?)?$/, '').replace(/\.mdx?$/, '');
    return { params: { slug: cleanSlug }, props: { ruta } };
  });
}

const { ruta } = Astro.props;
const { Content } = await render(ruta);
---

<Layout title={`${ruta.data.title} | Rutas Edi UrbanRide`}>
  
  {/* Cabecera Hero */}
  <div class="w-full bg-gray-900 border-b border-gray-800 pt-16 pb-12 px-4 relative overflow-hidden">
    {ruta.data.coverImage && (
      <div class="absolute inset-0 opacity-20 z-0">
         <Image src={ruta.data.coverImage} alt={ruta.data.title} class="w-full h-full object-cover blur-sm" />
      </div>
    )}
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <h1 class="text-4xl md:text-6xl font-bold text-white mb-4">{ruta.data.title}</h1>
      <p class="text-xl text-gray-300">{ruta.data.description}</p>
    </div>
  </div>

  {/* Menú de Pestañas Flotante */}
  <nav class="sticky top-[73px] z-40 bg-gray-900/95 backdrop-blur border-b border-gray-700 shadow-lg px-4 overflow-x-auto">
    <div class="max-w-4xl mx-auto flex gap-2 py-3 min-w-max">
      <a href="#info" class="px-4 py-2 bg-gray-800 hover:bg-yellow-500 hover:text-gray-900 text-gray-300 font-medium rounded-lg transition-colors text-sm">Información Básica</a>
      <a href="#descripcion" class="px-4 py-2 bg-gray-800 hover:bg-yellow-500 hover:text-gray-900 text-gray-300 font-medium rounded-lg transition-colors text-sm">Descripción</a>
      {(ruta.data.mapIframe || ruta.data.stravaLink) && <a href="#mapa" class="px-4 py-2 bg-gray-800 hover:bg-yellow-500 hover:text-gray-900 text-gray-300 font-medium rounded-lg transition-colors text-sm">Tracks y Mapa</a>}
      {ruta.data.youtubeId && <a href="#videos" class="px-4 py-2 bg-gray-800 hover:bg-yellow-500 hover:text-gray-900 text-gray-300 font-medium rounded-lg transition-colors text-sm">Videos</a>}
    </div>
  </nav>

  {/* Contenedor Principal */}
  <article class="max-w-4xl mx-auto py-12 px-4 space-y-16">
    
    <section id="info" class="scroll-mt-32">
      <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-2">
        <span class="w-2 h-6 bg-yellow-500 rounded-full block"></span> Información Básica
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-gray-800 p-4 rounded-xl border border-gray-700">
          <span class="text-xs text-gray-400 uppercase tracking-wider block mb-1">Distancia</span>
          <span class="text-lg font-bold text-white">{ruta.data.distance || "N/A"}</span>
        </div>
        <div class="bg-gray-800 p-4 rounded-xl border border-gray-700">
          <span class="text-xs text-gray-400 uppercase tracking-wider block mb-1">Dificultad</span>
          <span class="text-lg font-bold text-yellow-500">{ruta.data.difficulty || "N/A"}</span>
        </div>
        <div class="bg-gray-800 p-4 rounded-xl border border-gray-700">
          <span class="text-xs text-gray-400 uppercase tracking-wider block mb-1">Desnivel</span>
          <span class="text-lg font-bold text-white">{ruta.data.elevation || "N/A"}</span>
        </div>
        <div class="bg-gray-800 p-4 rounded-xl border border-gray-700">
          <span class="text-xs text-gray-400 uppercase tracking-wider block mb-1">Terreno</span>
          <span class="text-lg font-bold text-white">{ruta.data.terrain || "N/A"}</span>
        </div>
      </div>
      <div class="flex flex-wrap gap-4 mt-6">
        {ruta.data.stravaLink && (
          <a href={ruta.data.stravaLink} target="_blank" rel="noopener noreferrer" class="bg-gray-800 hover:bg-gray-700 text-yellow-500 border border-gray-700 px-6 py-2 rounded-lg font-bold transition-colors text-sm">
            Ver en Strava
          </a>
        )}
        {ruta.data.gpxFile && (
          <a href={ruta.data.gpxFile} download class="bg-yellow-500 hover:bg-yellow-400 text-gray-900 px-6 py-2 rounded-lg font-bold transition-colors text-sm">
            Descargar GPX
          </a>
        )}
      </div>
    </section>

    <section id="descripcion" class="scroll-mt-32">
      <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-2">
        <span class="w-2 h-6 bg-yellow-500 rounded-full block"></span> Descripción de la ruta
      </h2>
      <div class="prose prose-invert prose-yellow max-w-none bg-gray-800/50 p-6 md:p-8 rounded-2xl border border-gray-700">
        <Content />
      </div>
    </section>

    {ruta.data.mapIframe && (
      <section id="mapa" class="scroll-mt-32">
        <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-2">
          <span class="w-2 h-6 bg-yellow-500 rounded-full block"></span> Tracks y Mapa
        </h2>
        <div class="w-full h-[400px] bg-gray-800 rounded-2xl border border-gray-700 overflow-hidden" set:html={ruta.data.mapIframe}>
        </div>
      </section>
    )}

    {ruta.data.youtubeId && (
      <section id="videos" class="scroll-mt-32">
        <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-2">
          <span class="w-2 h-6 bg-yellow-500 rounded-full block"></span> Registro Audiovisual
        </h2>
        <div class="rounded-2xl overflow-hidden shadow-xl border border-gray-700 bg-gray-900 aspect-video relative">
          <iframe 
            class="absolute top-0 left-0 w-full h-full"
            src={`https://www.youtube.com/embed/${ruta.data.youtubeId}`} 
            title={`Video de la ruta ${ruta.data.title}`} 
            frameborder="0" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen>
          </iframe>
        </div>
      </section>
    )}

  </article>
</Layout>