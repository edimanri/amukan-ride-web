---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import bannerEdi from '../assets/banner_youtube_Edi.png';

const allRutas = await getCollection('rutas');
const allPosts = await getCollection('blog');

const latestRutas = allRutas.slice(0, 3);
const latestPosts = allPosts.sort((a, b) => {
  const dateA = a.data.pubDate ? a.data.pubDate.valueOf() : 0;
  const dateB = b.data.pubDate ? b.data.pubDate.valueOf() : 0;
  return dateB - dateA;
}).slice(0, 3);
---

<Layout title="Inicio">
  <!-- HERO -->
  <section class="relative w-full h-[60vh] md:h-[80vh] flex items-center justify-center overflow-hidden rounded-3xl mt-4 mb-16 border border-gray-700">
    <Image src={bannerEdi} alt="Banner Edi Urban Ride" class="absolute inset-0 w-full h-full object-cover z-0 opacity-30" />
    <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/70 to-transparent z-0"></div>
    
    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto flex flex-col items-center">
      <span class="text-yellow-500 font-bold tracking-widest uppercase text-sm mb-4 px-4 py-1 rounded-full bg-yellow-500/10 border border-yellow-500/20 backdrop-blur-sm">
        Plataforma Oficial
      </span>
      <h1 class="text-5xl md:text-7xl font-extrabold text-gray-50 mb-6 tracking-tight leading-tight drop-shadow-lg">
        Conquista la ciudad en <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-500 to-teal-400">dos ruedas</span>.
      </h1>
      <p class="text-lg md:text-xl text-gray-300 mb-10 max-w-2xl drop-shadow-md">
        Rutas técnicas, mecánica aplicada e ingeniería para el ciclismo urbano y deportivo en Santiago.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto justify-center">
        <a href="/rutas" class="px-8 py-4 bg-teal-600 hover:bg-teal-700 text-gray-50 font-bold rounded-xl transition-all duration-300 transform hover:scale-105 shadow-[0_0_20px_rgba(13,148,136,0.3)]">
          Explorar Catálogo
        </a>
        <a href="/academia" class="px-8 py-4 bg-gray-800 hover:bg-gray-700 text-teal-500 font-bold rounded-xl border border-gray-700 hover:border-teal-600 transition-all duration-300 backdrop-blur-sm">
          Academia Flycrew
        </a>
      </div>
    </div>
  </section>

  <!-- ÚLTIMAS RUTAS -->
  <section class="w-full mb-20">
    <div class="flex justify-between items-end mb-8 border-b border-gray-700 pb-4">
      <div>
        <h2 class="text-3xl font-bold text-gray-50">Nuevos Trazados</h2>
        <p class="text-gray-400 mt-2">La altimetría de la ciudad a tu disposición.</p>
      </div>
      <a href="/rutas" class="text-teal-600 hover:text-teal-500 text-sm font-medium hidden sm:block">Ver todas &rarr;</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {latestRutas.map((ruta) => {
        const cleanSlug = ruta.id.replace(/\/?index(\.mdx?)?$/, '').replace(/\.mdx?$/, '');
        return (
          <a href={`/rutas/${cleanSlug}`} class="group block bg-gray-800 rounded-2xl overflow-hidden border border-gray-700 hover:border-teal-600 transition-colors">
            <div class="aspect-video overflow-hidden relative bg-gray-900">
              {ruta.data.coverImage ? (
                <Image src={ruta.data.coverImage} alt={ruta.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              ) : (
                <div class="w-full h-full flex items-center justify-center">
                  <span class="text-gray-400 text-sm">Sin imagen</span>
                </div>
              )}
              <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-gray-900 to-transparent p-4">
                {ruta.data.difficulty && (
                  <span class="text-yellow-500 text-xs font-bold bg-gray-900/90 px-2 py-1 rounded border border-gray-700">{ruta.data.difficulty}</span>
                )}
              </div>
            </div>
            <div class="p-5">
              <h3 class="text-lg font-bold text-gray-50 group-hover:text-teal-500 transition-colors mb-2">{ruta.data.title}</h3>
              <div class="flex gap-4 text-xs text-gray-400 font-medium">
                {ruta.data.distance && <span>{ruta.data.distance} km</span>}
                {ruta.data.elevation && <span>{ruta.data.elevation} m+</span>}
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- ÚLTIMOS ARTÍCULOS -->
  <section class="w-full mb-10">
    <div class="flex justify-between items-end mb-8 border-b border-gray-700 pb-4">
      <div>
        <h2 class="text-3xl font-bold text-gray-50">Bitácora Técnica</h2>
        <p class="text-gray-400 mt-2">Ingeniería y mecánica aplicada a la bicicleta.</p>
      </div>
      <a href="/blog" class="text-teal-600 hover:text-teal-500 text-sm font-medium hidden sm:block">Leer blog &rarr;</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {latestPosts.map((post) => {
        const cleanSlug = post.id.replace(/\/?index(\.mdx?)?$/, '').replace(/\.mdx?$/, '');
        return (
          <a href={`/blog/${cleanSlug}`} class="group flex flex-col md:flex-row col-span-1 md:col-span-3 bg-gray-800 rounded-xl overflow-hidden border border-gray-700 hover:border-teal-600 transition-colors">
            <div class="md:w-1/4 aspect-video md:aspect-square overflow-hidden bg-gray-900">
              {post.data.coverImage ? (
                <Image src={post.data.coverImage} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              ) : (
                <div class="w-full h-full flex items-center justify-center">
                  <span class="text-gray-400 text-sm">Sin imagen</span>
                </div>
              )}
            </div>
            <div class="p-6 md:w-3/4 flex flex-col justify-center">
              <h3 class="text-xl font-bold text-gray-50 group-hover:text-teal-500 transition-colors mb-2">{post.data.title}</h3>
              {post.data.description && (
                <p class="text-sm text-gray-300 line-clamp-2">{post.data.description}</p>
              )}
            </div>
          </a>
        );
      })}
    </div>
  </section>
</Layout>