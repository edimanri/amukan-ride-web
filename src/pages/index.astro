---
// Ruta: src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

// Importamos la imagen estática directamente desde tu carpeta de recursos
import bannerEdi from '../assets/banner_youtube_Edi.png';

const allRutas = await getCollection('rutas');
const allPosts = await getCollection('blog');

const latestRutas = allRutas.slice(0, 3);
const latestPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---

<Layout title="Inicio">
  <!-- SECCIÓN 1: HERO (Portada con Banner Integrado) -->
  <section class="relative w-full h-[60vh] md:h-[80vh] flex items-center justify-center overflow-hidden rounded-3xl mt-4 mb-16 border border-slate-800">
    
    <!-- Imagen de fondo optimizada por Astro -->
    <Image 
      src={bannerEdi} 
      alt="Banner Edi Urban Ride" 
      class="absolute inset-0 w-full h-full object-cover z-0 opacity-30" 
    />
    
    <!-- Gradiente superpuesto para garantizar la legibilidad del texto -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/60 to-transparent z-0"></div>
    
    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto flex flex-col items-center">
      <span class="text-emerald-400 font-bold tracking-widest uppercase text-sm mb-4 px-4 py-1 rounded-full bg-emerald-400/10 border border-emerald-400/20 backdrop-blur-sm">
        Plataforma Oficial
      </span>
      <h1 class="text-5xl md:text-7xl font-extrabold text-white mb-6 tracking-tight leading-tight drop-shadow-lg">
        Conquista la ciudad en <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-500">dos ruedas</span>.
      </h1>
      <p class="text-lg md:text-xl text-slate-200 mb-10 max-w-2xl drop-shadow-md">
        Rutas técnicas, mecánica aplicada e ingeniería para el ciclismo urbano y deportivo en Santiago.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto justify-center">
        <a href="/rutas" class="px-8 py-4 bg-emerald-500 hover:bg-emerald-400 text-slate-900 font-bold rounded-xl transition-all duration-300 transform hover:scale-105 shadow-[0_0_20px_rgba(16,185,129,0.3)]">
          Explorar Catálogo
        </a>
        <a href="/academia" class="px-8 py-4 bg-slate-800/80 hover:bg-slate-700 text-emerald-400 font-bold rounded-xl border border-slate-700 hover:border-emerald-500/50 transition-all duration-300 backdrop-blur-sm">
          Academia Flycrew
        </a>
      </div>
    </div>
  </section>

  <!-- SECCIÓN 2: ÚLTIMAS RUTAS -->
  <section class="w-full mb-20">
    <div class="flex justify-between items-end mb-8 border-b border-slate-800 pb-4">
      <div>
        <h2 class="text-3xl font-bold text-slate-100">Nuevos Trazados</h2>
        <p class="text-slate-400 mt-2">La altimetría de la ciudad a tu disposición.</p>
      </div>
      <a href="/rutas" class="text-emerald-400 hover:text-emerald-300 text-sm font-medium hidden sm:block">Ver todas &rarr;</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {latestRutas.map((ruta) => (
        <a href={`/rutas/${ruta.id}`} class="group block bg-slate-800/40 rounded-2xl overflow-hidden border border-slate-700 hover:border-emerald-500/50 transition-colors">
          <div class="aspect-video overflow-hidden relative">
            <Image src={ruta.data.cover} alt={ruta.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-950 to-transparent p-4">
              <span class="text-emerald-400 text-xs font-bold bg-slate-900/80 px-2 py-1 rounded border border-slate-700">{ruta.data.difficulty}</span>
            </div>
          </div>
          <div class="p-5">
            <h3 class="text-lg font-bold text-slate-100 group-hover:text-emerald-400 transition-colors mb-2">{ruta.data.title}</h3>
            <div class="flex gap-4 text-xs text-slate-400 font-medium">
              <span>{ruta.data.distance} km</span>
              <span>{ruta.data.elevation} m+</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- SECCIÓN 3: ÚLTIMOS ARTÍCULOS -->
  <section class="w-full mb-10">
    <div class="flex justify-between items-end mb-8 border-b border-slate-800 pb-4">
      <div>
        <h2 class="text-3xl font-bold text-slate-100">Bitácora Técnica</h2>
        <p class="text-slate-400 mt-2">Ingeniería y mecánica aplicada a la bicicleta.</p>
      </div>
      <a href="/blog" class="text-emerald-400 hover:text-emerald-300 text-sm font-medium hidden sm:block">Leer blog &rarr;</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {latestPosts.map((post) => (
        <a href={`/blog/${post.id}`} class="group flex flex-col md:flex-row col-span-1 md:col-span-3 bg-slate-800/30 rounded-xl overflow-hidden border border-slate-700/50 hover:bg-slate-800/50 transition-colors">
          <div class="md:w-1/4 aspect-video md:aspect-square overflow-hidden">
            <Image src={post.data.cover} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-6 md:w-3/4 flex flex-col justify-center">
            <span class="text-emerald-400 text-xs font-bold mb-2">{post.data.tags?.[0]}</span>
            <h3 class="text-xl font-bold text-slate-100 group-hover:text-emerald-400 transition-colors mb-2">{post.data.title}</h3>
            <p class="text-sm text-slate-400 line-clamp-2">{post.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>