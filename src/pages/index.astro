---
import Layout from '../layouts/Layout.astro';
import { getImage } from 'astro:assets';
import bannerImage from '../assets/banner_youtube_Edi.png';

const optimizedBanner = await getImage({ src: bannerImage, format: 'webp' });
---

<Layout title="Edi UrbanRide | Consultoría en Movilidad">
  <div class="relative w-full h-[80vh] flex items-center justify-center overflow-hidden bg-gray-900" style={`background-image: url(${optimizedBanner.src}); background-size: cover; background-position: center;`}>
    
    <!-- Capa oscura semitransparente (80% de opacidad) para dar contraste al texto -->
    <div class="absolute inset-0 bg-gray-900/80 z-0"></div>
    
    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
      <span class="text-yellow-500 font-bold tracking-widest uppercase text-sm mb-6 px-4 py-1 rounded-full bg-yellow-500/10 border border-yellow-500/20 inline-block">
        Plataforma Oficial
      </span>
      <h1 class="text-5xl md:text-7xl font-bold text-white mt-4 mb-6 tracking-tight">
        Conquista la ciudad en <br/><span class="text-yellow-500">dos ruedas.</span>
      </h1>
      <p class="text-lg md:text-xl text-gray-300 mb-10 max-w-2xl mx-auto">
        Rutas técnicas, mecánica aplicada e ingeniería para el ciclismo urbano y deportivo en Santiago.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/rutas" class="px-8 py-4 bg-yellow-500 hover:bg-yellow-400 text-gray-900 font-bold rounded-xl transition-all duration-300 shadow-[0_0_15px_rgba(234,179,8,0.3)]">
          Explorar Catálogo
        </a>
        <a href="/academia" class="px-8 py-4 bg-gray-800/80 hover:bg-gray-700 text-white font-bold rounded-xl transition-all duration-300 border border-gray-700 backdrop-blur-sm">
          Academia Flycrew
        </a>
      </div>
    </div>
  </div>
</Layout>