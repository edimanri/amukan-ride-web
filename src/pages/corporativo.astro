---
// Ruta: src/pages/corporativo.astro
import Layout from '../layouts/Layout.astro';
import YouTubeLite from '../components/YouTubeLite.astro';
import ContactForm from '../components/ContactForm.jsx';
---

<Layout title="Servicios Corporativos">
  <div class="max-w-6xl mx-auto py-20 px-4">
    <!-- Encabezado de la página -->
    <header class="text-center mb-20">
      <span class="text-cyan-400 font-bold tracking-widest uppercase text-sm mb-4 px-4 py-1 rounded-full bg-cyan-400/10 border border-cyan-400/20">
        División B2B
      </span>
      <h1 class="text-4xl md:text-6xl font-bold text-white mt-6 mb-6 tracking-tight">
        Soluciones institucionales en movilidad.
      </h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto">
        Integramos la ingeniería mecánica y la gestión de proyectos deportivos para potenciar el capital humano e infraestructura de su empresa.
      </p>
    </header>

    <!-- Sección de Respaldo Técnico -->
    <section class="mb-24 bg-gray-800/30 border border-gray-700/50 rounded-3xl p-8 md:p-12">
      <div class="flex flex-col md:flex-row gap-10 items-center">
        <div class="md:w-1/2">
          <h2 class="text-3xl font-bold text-white mb-4">Ingeniería Aplicada</h2>
          <p class="text-gray-300 mb-6 leading-relaxed">
            Amukan Ride SpA opera bajo un estricto rigor técnico. Al estar fundamentados en la Ingeniería Civil Mecánica, abordamos la movilidad corporativa y el deporte no solo desde la pasión, sino con metodologías estructuradas. 
          </p>
          <p class="text-gray-300 leading-relaxed">
            Aplicamos estándares de gestión EPCM y herramientas de modelado (BIM) cuando asesoramos en infraestructura, garantizando que cada clínica de ciclismo o proyecto de movilidad activa tenga métricas de rendimiento claras y seguras.
          </p>
        </div>
        <div class="md:w-1/2 grid grid-cols-2 gap-4">
          <div class="bg-gray-900/50 p-6 rounded-2xl border border-gray-700">
            <span class="block text-3xl font-extrabold text-cyan-400 mb-2">15+</span>
            <span class="text-sm text-gray-400">Años de experiencia en múltiples disciplinas ciclistas.</span>
          </div>
          <div class="bg-gray-900/50 p-6 rounded-2xl border border-gray-700">
            <span class="block text-3xl font-extrabold text-teal-400 mb-2">12</span>
            <span class="text-sm text-gray-400">Semanas de ciclo formativo estructurado para equipos.</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Catálogo de Servicios Corporativos -->
    <section class="mb-20">
      <h2 class="text-3xl font-bold text-white mb-10 text-center">Líneas de Servicio</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-gray-800/40 rounded-2xl p-8 border border-gray-700 hover:border-cyan-500/50 transition-colors flex flex-col">
          <div class="w-12 h-12 bg-cyan-900/50 text-cyan-400 rounded-xl flex items-center justify-center mb-6 border border-cyan-500/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Clínicas para Equipos</h3>
          <p class="text-gray-400 text-sm flex-grow">Programas formativos orientados a la mecánica de grupo, control de frenado y conducción segura.</p>
        </div>

        <div class="bg-gray-800/40 rounded-2xl p-8 border border-gray-700 hover:border-cyan-500/50 transition-colors flex flex-col">
          <div class="w-12 h-12 bg-cyan-900/50 text-cyan-400 rounded-xl flex items-center justify-center mb-6 border border-cyan-500/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Consultoría en Movilidad</h3>
          <p class="text-gray-400 text-sm flex-grow">Asesoría técnica para el diseño de instalaciones ciclistas corporativas y fomento de movilidad activa.</p>
        </div>

        <div class="bg-gray-800/40 rounded-2xl p-8 border border-gray-700 hover:border-cyan-500/50 transition-colors flex flex-col">
          <div class="w-12 h-12 bg-cyan-900/50 text-cyan-400 rounded-xl flex items-center justify-center mb-6 border border-cyan-500/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Auspicios y Alianzas</h3>
          <p class="text-gray-400 text-sm flex-grow">Desarrollo de campañas conjuntas y creación de contenido especializado a través de Ediurbanride.</p>
        </div>
      </div>
    </section>

    <!-- Portafolio Audiovisual -->
    <section class="mb-24">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-white mb-4">Registro Documental</h2>
        <p class="text-gray-400 max-w-2xl mx-auto">
          Proyectos de divulgación y análisis técnico desarrollados en la ciudad.
        </p>
      </div>
      
      <div class="max-w-3xl mx-auto">
        <YouTubeLite videoId="S8dKj08CWWM" title="Ciclismo Urbano - Ediurbanride" />
      </div>
    </section>

    <!-- Formulario Interactivo (Isla de React) -->
    <section class="bg-gradient-to-r from-cyan-900/20 to-gray-900/50 rounded-3xl p-6 md:p-10 border border-cyan-800/30">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-white mb-4">Iniciemos un proyecto</h2>
        <p class="text-gray-300 max-w-xl mx-auto">
          Describa los requerimientos específicos de su organización para diseñar una propuesta técnica a medida.
        </p>
      </div>
      
      <!-- client:visible activa la hidratación de React solo al hacer scroll -->
      <ContactForm client:visible />
    </section>

    <!-- Llamado a la acción de correo directo -->
    <div class="mt-12 text-center">
      <p class="text-gray-400 mb-4">¿Prefiere contacto directo?</p>
      <a href="mailto:ediurbanride@gmail.com" class="inline-block px-8 py-4 bg-cyan-600 hover:bg-cyan-500 text-white font-bold rounded-xl transition-all duration-300 shadow-[0_0_15px_rgba(8,145,178,0.4)]">
        Escríbanos un correo
      </a>
    </div>
  </div>
</Layout>