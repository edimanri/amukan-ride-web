---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

// Modificamos esta función para limpiar el "/index" del nombre de la ruta
export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  
  return blogEntries.map(entry => {
    // Si Astro detecta el archivo como "mi-post/index", le borramos el "/index"
    const cleanSlug = entry.slug.replace(/\/index$/, '');
    
    // Imprimimos en la consola de Vercel las URLs que se están creando (para diagnóstico)
    console.log(`Generando ruta: /blog/${cleanSlug}`);
    
    return {
      params: { slug: cleanSlug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={entry.data.title}>
  <article class="max-w-3xl mx-auto px-4 py-8">
    <header class="mb-8 text-center">
      <h1 class="text-4xl font-bold mb-4">{entry.data.title}</h1>
      <p class="text-gray-400 mb-4">{entry.data.description}</p>
      
      {/* Mostrar la imagen de portada si existe en el Frontmatter */}
      {entry.data.coverImage && (
        <Image 
          src={entry.data.coverImage} 
          alt={`Portada de ${entry.data.title}`}
          width={800}
          height={400}
          class="rounded-lg shadow-lg mx-auto"
        />
      )}
    </header>

    {/* Aquí se inyecta todo el contenido que escribiste en Keystatic */}
    <div class="prose prose-invert lg:prose-xl mx-auto">
      <Content />
    </div>
  </article>
</Layout>