---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

// Esta función le dice a Astro qué URLs debe generar basándose en los artículos de Keystatic
export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
// Renderizamos el contenido MDX a HTML
const { Content } = await entry.render();
---

<Layout title={entry.data.title}>
  <article class="max-w-3xl mx-auto px-4 py-8">
    <header class="mb-8 text-center">
      <h1 class="text-4xl font-bold mb-4">{entry.data.title}</h1>
      <p class="text-gray-400 mb-4">{entry.data.description}</p>
      
      {/* Mostrar la imagen de portada si existe en el Frontmatter */}
      {entry.data.coverImage && (
        <Image 
          src={entry.data.coverImage} 
          alt={`Portada de ${entry.data.title}`}
          width={800}
          height={400}
          class="rounded-lg shadow-lg mx-auto"
        />
      )}
    </header>

    {/* Aquí se inyecta todo el contenido que escribiste en Keystatic */}
    <div class="prose prose-invert lg:prose-xl mx-auto">
      <Content />
    </div>
  </article>
</Layout>