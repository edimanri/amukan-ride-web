---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

// Modificamos esta función para usar la propiedad 'id' en lugar del antiguo 'slug'
export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  
  return blogEntries.map(entry => {
    // Usamos entry.id y limpiamos el "/index" o la extensión si existe
    const cleanSlug = entry.id.replace(/\/?index(\.mdx?)?$/, '').replace(/\.mdx?$/, '');
    
    console.log(`Generando ruta: /blog/${cleanSlug}`);
    
    return {
      params: { slug: cleanSlug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
// En Astro v5 usamos la función render() importada
const { Content } = await render(entry);
---

<Layout title={entry.data.title}>
  <article class="max-w-3xl mx-auto px-4 py-8">
    <header class="mb-8 text-center">
      <h1 class="text-4xl font-bold mb-4">{entry.data.title}</h1>
      <p class="text-gray-400 mb-4">{entry.data.description}</p>
      
      {/* Mostrar la imagen de portada si existe en el Frontmatter */}
      {entry.data.coverImage && (
        <Image 
          src={entry.data.coverImage} 
          alt={`Portada de ${entry.data.title}`}
          width={800}
          height={400}
          class="rounded-lg shadow-lg mx-auto"
        />
      )}
    </header>

    {/* Aquí se inyecta todo el contenido que escribiste en Keystatic */}
    <div class="prose prose-invert lg:prose-xl mx-auto">
      <Content />
    </div>
  </article>
</Layout>