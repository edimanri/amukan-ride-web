---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

// Obtenemos todos los artículos de la colección 'blog'
const posts = await getCollection('blog');
---

<Layout title="Blog - Amukan Ride">
  <main class="max-w-6xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-center mb-12">Nuestro Blog</h1>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map((post) => {
        // Limpiamos el ID para generar la URL correcta (compatible con Astro v5)
        const cleanSlug = post.id.replace(/\/?index(\.mdx?)?$/, '').replace(/\.mdx?$/, '');
        
        return (
          <article class="bg-gray-900 rounded-lg overflow-hidden shadow-lg border border-gray-800 hover:border-gray-700 transition-colors">
            <a href={`/blog/${cleanSlug}`} class="block overflow-hidden h-48">
              {/* Condición que protege la compilación si el artículo no tiene foto */}
              {post.data.coverImage ? (
                <Image 
                  src={post.data.coverImage} 
                  alt={post.data.title}
                  width={600}
                  height={400}
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                />
              ) : (
                <div class="w-full h-full bg-gray-800 flex items-center justify-center hover:bg-gray-700 transition-colors">
                  <span class="text-gray-500 text-sm">Sin imagen de portada</span>
                </div>
              )}
            </a>
            
            <div class="p-6">
              <a href={`/blog/${cleanSlug}`}>
                <h2 class="text-xl font-bold mb-2 hover:text-blue-400 transition-colors">
                  {post.data.title}
                </h2>
              </a>
              {post.data.description && (
                <p class="text-gray-400 text-sm mb-4 line-clamp-3">
                  {post.data.description}
                </p>
              )}
              {post.data.pubDate && (
                <time class="text-xs text-gray-500">
                  {new Date(post.data.pubDate).toLocaleDateString('es-CL')}
                </time>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </main>
</Layout>