---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const posts = await getCollection('blog');
---

<Layout title="Blog y Artículos">
  <div class="max-w-6xl mx-auto py-20 px-4">
    <header class="text-center mb-16">
      <span class="text-yellow-500 font-bold tracking-widest uppercase text-sm mb-4 px-4 py-1 rounded-full bg-yellow-500/10 border border-yellow-500/20">
        Opinión y Técnica
      </span>
      <h1 class="text-4xl md:text-5xl font-bold text-white mt-6 mb-6 tracking-tight">Blog Técnico</h1>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map((post) => {
        const cleanSlug = post.id.replace(/\/?index(\.mdx?)?$/, '').replace(/\.mdx?$/, '');
        
        return (
        <a href={`/blog/${cleanSlug}`} class="bg-gray-800 border border-gray-700 hover:border-yellow-500 transition-colors rounded-2xl overflow-hidden block group flex flex-col h-full">
          {post.data.coverImage ? (
            <div class="aspect-video relative overflow-hidden bg-gray-900">
              <Image 
                src={post.data.coverImage} 
                alt={post.data.title} 
                class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-500" 
              />
            </div>
          ) : (
            <div class="aspect-video bg-gray-900 flex items-center justify-center text-gray-600">
              Sin imagen de portada
            </div>
          )}
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-xs font-bold text-yellow-500 uppercase tracking-wider mb-2 block">Artículo</span>
            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-yellow-500 transition-colors">{post.data.title}</h3>
            {post.data.description && <p class="text-sm text-gray-400 flex-grow">{post.data.description}</p>}
          </div>
        </a>
      )})}
    </div>
  </div>
</Layout>