---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Blog y Artículos">
  <div class="max-w-6xl mx-auto py-20 px-4">
    <header class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-bold text-white tracking-tight">Blog Técnico</h1>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <a href="#" class="bg-gray-800 border border-gray-700 hover:border-yellow-500 transition-colors rounded-2xl overflow-hidden block group">
        <div class="h-48 bg-gray-900 flex items-center justify-center text-gray-600">
          Próximamente
        </div>
        <div class="p-6">
          <span class="text-xs font-bold text-yellow-500 uppercase tracking-wider mb-2 block">Mecánica</span>
          <h3 class="text-xl font-bold text-white mb-2 group-hover:text-yellow-500 transition-colors">Artículo en desarrollo</h3>
          <p class="text-sm text-gray-400">Contenido técnico de ingeniería aplicada al ciclismo.</p>
        </div>
      </a>
    </div>
  </div>
</Layout>