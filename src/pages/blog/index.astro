---
// Ruta: src/pages/blog/index.astro
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog de Ciclismo">
  <div class="w-full">
    <header class="text-center mb-16 mt-8">
      <h1 class="text-4xl font-bold text-emerald-400 tracking-tight">Bitácora Urbana</h1>
      <p class="mt-4 text-slate-300 max-w-2xl mx-auto">Tips, mecánica y análisis técnico sobre ciclismo urbano y deportivo.</p>
    </header>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sortedPosts.map((post) => (
        <article class="bg-slate-800/50 rounded-2xl overflow-hidden border border-slate-700 hover:border-emerald-500/50 transition-colors flex flex-col">
          <a href={`/blog/${post.id}`} class="block aspect-video overflow-hidden">
            <Image src={post.data.cover} alt={post.data.title} class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" />
          </a>
          <div class="p-6 flex flex-col flex-grow">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs font-medium text-emerald-400 bg-emerald-400/10 px-3 py-1 rounded-full">{post.data.tags?.[0] || 'Artículo'}</span>
              <span class="text-xs text-slate-400">{post.data.pubDate.toISOString().split('T')[0]}</span>
            </div>
            <a href={`/blog/${post.id}`} class="group">
              <h2 class="text-xl font-bold text-slate-100 group-hover:text-emerald-400 transition-colors mb-2">{post.data.title}</h2>
            </a>
            <p class="text-sm text-slate-400 mb-4 flex-grow line-clamp-3">{post.data.description}</p>
            <a href={`/blog/${post.id}`} class="text-sm font-medium text-emerald-400 hover:text-emerald-300 mt-auto flex items-center gap-1">Leer artículo <span aria-hidden="true">&rarr;</span></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>