---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Academia y Entrenamiento">
  <div class="max-w-5xl mx-auto py-20 px-4">
    
    <header class="text-center mb-16">
      <span class="text-yellow-500 font-bold tracking-widest uppercase text-sm mb-4 px-4 py-1 rounded-full bg-yellow-500/10 border border-yellow-500/20">
        Entrenamiento Estructurado
      </span>
      <h1 class="text-4xl md:text-6xl font-bold text-white mt-6 mb-6 tracking-tight">
        Sube tu nivel en el asfalto.
      </h1>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto">
        Programas de acondicionamiento físico, clínicas de técnica de conducción y una comunidad enfocada en el rendimiento urbano y deportivo.
      </p>
    </header>

    <div class="bg-gray-800 border border-gray-700 rounded-3xl p-8 md:p-12 max-w-3xl mx-auto shadow-2xl relative overflow-hidden">
      <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 bg-yellow-500/10 rounded-full blur-3xl z-0"></div>
      
      <div class="relative z-10 flex flex-col md:flex-row gap-12 items-center">
        <div class="flex-1">
          <h2 class="text-3xl font-bold text-white mb-2">Membresía Flycrew</h2>
          <p class="text-gray-400 mb-8">Acceso total a la plataforma de alumnos, rutinas semanales y soporte técnico.</p>
          
          <ul class="space-y-4 mb-8">
            <li class="flex items-start">
              <svg class="w-6 h-6 text-yellow-500 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span class="text-gray-300">Planificación mensual para rodillo (indoor) y salidas al aire libre.</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-yellow-500 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span class="text-gray-300">Análisis biomecánico básico para ajustes de la bicicleta (Bike Fit).</span>
            </li>
            <li class="flex items-start">
              <svg class="w-6 h-6 text-yellow-500 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span class="text-gray-300">Acceso exclusivo a la comunidad privada en Telegram / Discord.</span>
            </li>
          </ul>
        </div>
        
        <div class="w-full md:w-auto flex flex-col items-center p-6 bg-gray-900 rounded-2xl border border-gray-700">
          <div class="text-center mb-6">
            <span class="text-sm text-gray-400 uppercase tracking-wide">Suscripción Mensual</span>
            <div class="mt-2 flex justify-center items-baseline">
              <span class="text-4xl font-extrabold text-white">$XX.XXX</span>
              <span class="text-gray-400 ml-1">/mes</span>
            </div>
          </div>
          
          <a href="https://flycrew.com/w/edison-manriquez" target="_blank" rel="noopener noreferrer" class="w-full text-center px-8 py-4 bg-yellow-500 hover:bg-yellow-400 text-gray-900 font-bold rounded-xl transition-all duration-300 transform hover:scale-105 shadow-[0_0_20px_rgba(234,179,8,0.3)]">
            Inscribirme en Flycrew
          </a>
          <p class="text-xs text-gray-500 mt-4 text-center">Pagos seguros gestionados externamente.</p>
        </div>
      </div>
    </div>

  </div>
</Layout>