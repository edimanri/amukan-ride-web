---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="bg-gray-900 scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-gray-900 text-gray-300 min-h-screen flex flex-col">
    
    <!-- BARRA DE NAVEGACIÓN -->
    <nav class="bg-gray-800 border-b border-gray-700 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4">
        <div class="flex flex-col md:flex-row justify-between items-center h-auto md:h-16 py-4 md:py-0">
          
          <!-- NUEVO LOGO / AUTORIDAD -->
          <div class="flex items-center mb-4 md:mb-0">
            <a href="/" class="text-xl font-black tracking-tight text-white hover:text-teal-400 transition-colors flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2">
              <span>Edi UrbanRide</span>
              <span class="text-xs text-teal-500 font-medium tracking-normal hidden sm:inline">| Consultoría en Movilidad & ESG</span>
            </a>
          </div>
          
          <!-- ENLACES -->
          <div class="flex flex-wrap justify-center gap-4 md:space-x-8">
            <a href="/" class="text-sm font-medium text-gray-300 hover:text-teal-500 transition-colors">Inicio</a>
            <a href="/rutas" class="text-sm font-medium text-gray-300 hover:text-teal-500 transition-colors">Rutas</a>
            <a href="/blog" class="text-sm font-medium text-gray-300 hover:text-teal-500 transition-colors">Blog</a>
            <a href="/academia" class="text-sm font-medium text-gray-300 hover:text-teal-500 transition-colors">Academia</a>
            <a href="/corporativo" class="text-sm font-medium text-gray-300 hover:text-teal-500 transition-colors">Corporativo</a>
          </div>

        </div>
      </div>
    </nav>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="bg-gray-800 border-t border-gray-700 py-8 mt-auto">
      <div class="max-w-6xl mx-auto px-4 text-center">
        <p class="text-sm text-gray-400">
          &copy; {new Date().getFullYear()} Edison Manríquez. Todos los derechos reservados.
        </p>
      </div>
    </footer>

  </body>
</html>