---
// Ruta: src/components/Navbar.astro
const links = [
  { name: 'Inicio', url: '/' },
  { name: 'Rutas', url: '/rutas' },
  { name: 'Blog', url: '/blog' },
  { name: 'Academia', url: '/academia' },
  { name: 'Corporativo', url: '/corporativo' }
];
---

<nav class="bg-slate-900/90 backdrop-blur-sm border-b border-slate-800 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <div class="flex-shrink-0">
        <a href="/" class="text-xl font-bold text-emerald-400 tracking-wider">AMUKAN</a>
      </div>
      <div class="flex space-x-2 sm:space-x-6 overflow-x-auto">
        {links.map((link) => (
          <a 
            href={link.url} 
            class="text-slate-300 hover:text-emerald-400 px-2 py-2 text-sm font-medium transition-colors"
          >
            {link.name}
          </a>
        ))}
      </div>
    </div>
  </div>
</nav>